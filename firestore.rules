rules_version = '2';

// Regras do Firestore para a conta na nuvem do app devocional. Ver
// lib/data/nuvem.dart para o código que lê e grava aqui.
//
// Publicadas à mão no console do Firebase (Firestore Database > Regras), ou
// com `firebase deploy --only firestore:rules`. Este arquivo é a fonte da
// verdade; não editar o console e este arquivo em separado.
//
// Contrato do documento usuarios/{uid} (ver nuvem.dart):
//   copia       mapa — a cópia de segurança que exportar() produz, com o
//               esquema fixo {versao: int, marcacoes: list, dias_lidos: list}
//   conversas   mapa — o histórico dos chats, serializado à parte
//   atualizadoEm timestamp do servidor, gravado em toda escrita
// O documento pode nascer só com copia ou só com conversas (cada sincronia
// escreve os próprios campos com merge), por isso os campos opcionais são
// validados apenas quando presentes.
//
// Limite do idioma: a linguagem de regras não itera mapas nem listas (não há
// loop, e recursão é rejeitada na compilação). Por isso os tipos e tetos
// abaixo só alcançam as chaves conhecidas e estáticas do contrato; o
// conteúdo de mapas aninhados fica no teto de 1 MiB por documento do
// próprio Firestore, e é sempre do próprio usuário.
service cloud.firestore {
  match /databases/{database}/documents {
    // Cada um lê e escreve só o próprio documento, identificado pelo uid da
    // conta Google. Sem este `match`, o padrão do Firestore já é negar tudo
    // — mas ele fica explícito porque é a única linha que impede alguém de
    // ler a cópia de outra pessoa. O provedor também é restrito: o app só
    // entra com Google, e um provedor habilitado por engano no console não
    // ganha documento.
    match /usuarios/{uid} {
      function dono() {
        return request.auth != null &&
            request.auth.uid == uid &&
            request.auth.token.firebase.sign_in_provider == 'google.com';
      }

      // Esquema da cópia: as três chaves de exportar() em estado.dart são
      // fixas e conhecidas, então dá para validar forma e tipos de cada uma.
      function copiaValida() {
        let c = request.resource.data.copia;
        return c.keys().hasOnly(['versao', 'marcacoes', 'dias_lidos']) &&
            c.versao is int &&
            c.marcacoes is list && c.marcacoes.size() < 5000 &&
            c.dias_lidos is list && c.dias_lidos.size() < 5000;
      }

      // Conversas: mapa de personas com teto de chaves. O submapa `apagadas`
      // (lápides de exclusão) também é tipado e limitado quando presente.
      function conversasValidas() {
        let cs = request.resource.data.conversas;
        return cs.size() < 5000 &&
            (!('apagadas' in cs) ||
                (cs.apagadas is map && cs.apagadas.size() < 5000));
      }

      // Forma e tipo do documento, para um cliente torto não gravar lixo no
      // próprio documento nem inflar o projeto com campos fora do contrato.
      function valido() {
        let dados = request.resource.data;
        let soOsCampos = dados.keys().hasOnly(['copia', 'conversas', 'atualizadoEm']);
        let copiaOk = !('copia' in dados) || copiaValida();
        let conversasOk = !('conversas' in dados) || conversasValidas();
        return soOsCampos && copiaOk && conversasOk &&
            dados.atualizadoEm is timestamp;
      }

      // create e update separados: o update também não pode trocar campos
      // fora do contrato (diff().affectedKeys().hasOnly). Sem isto, criar um
      // documento válido e atualizá-lo para um estado inválido seria livre.
      allow create: if dono() && valido();
      allow update: if dono() && valido() &&
          request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['copia', 'conversas', 'atualizadoEm']);
      allow delete: if dono();
      allow read: if dono();
    }

    // Planos de leitura compartilhados (ver lib/data/planos_nuvem.dart).
    //
    // Contrato do documento planos/{planoId}:
    //   titulo        string
    //   livros        list de slugs do canon
    //   dias          int >= 1
    //   criadoPor     string — uid de quem criou
    //   criadoEm      timestamp do servidor
    //   participantes mapa uid -> {nome: string, lidos: list de int}
    //
    // Quem cria o documento entra como primeiro participante. Depois disso,
    // qualquer participante lê o documento inteiro — é isso que permite ver
    // o progresso de todos — e cada um só pode escrever na própria entrada:
    // entrar (criar a própria entrada), marcar dias ou sair (apagá-la). Só o
    // criador apaga o plano para todos.
    match /planos/{planoId} {
      function google() {
        return request.auth != null &&
            request.auth.token.firebase.sign_in_provider == 'google.com';
      }

      // Entrada própria válida: ausente (saindo do plano) ou com nome e
      // lista de dias dentro dos tetos.
      function minhaEntradaValida(uid) {
        let entrada = request.resource.data.participantes[uid];
        return !(uid in request.resource.data.participantes) ||
            (entrada is map &&
                'nome' in entrada && entrada.nome is string &&
                entrada.nome.size() < 100 &&
                'lidos' in entrada && entrada.lidos is list &&
                entrada.lidos.size() <= 1000);
      }

      // A escrita só toca a própria entrada de `uid` no mapa de
      // participantes — nem outros participantes, nem campos do plano.
      function soAParticipacaoDoProprio(uid) {
        return request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['participantes']) &&
            request.resource.data.participantes.diff(resource.data.participantes)
                .affectedKeys().hasOnly([uid]) &&
            minhaEntradaValida(uid);
      }

      allow create: if google() &&
          request.resource.data.criadoPor == request.auth.uid &&
          request.resource.data.criadoEm is timestamp &&
          request.resource.data.titulo is string &&
          request.resource.data.titulo.size() <= 200 &&
          request.resource.data.livros is list &&
          request.resource.data.livros.size() <= 66 &&
          request.resource.data.dias is int &&
          request.resource.data.dias >= 1 && request.resource.data.dias <= 730 &&
          'participantes' in request.resource.data &&
          request.resource.data.participantes.keys()
              .hasOnly([request.auth.uid]) &&
          minhaEntradaValida(request.auth.uid);

      // Participantes leem o plano inteiro (títulos, progresso de todos).
      allow read: if google() &&
          'participantes' in resource.data &&
          resource.data.participantes is map &&
          request.auth.uid in resource.data.participantes;

      // Entrar, marcar dias e sair são o mesmo tipo de escrita: só a
      // própria entrada. Quem ainda não participa pode criá-la (é o entrar
      // pelo link); quem participa pode mudá-la ou apagá-la.
      allow update: if google() && soAParticipacaoDoProprio(request.auth.uid);

      allow delete: if google() && resource.data.criadoPor == request.auth.uid;
    }

    // Lembrete diário do devocional (ver lib/data/lembretes.dart e
    // tool/enviar_lembretes.dart). Sem login — o lembrete não pede conta, e
    // por isso não há uid para checar dono. O id do documento é o próprio
    // token do FCM deste aparelho, então a proteção contra escrita de
    // terceiros é o App Check (ativado no app inteiro em Nuvem.iniciar), não
    // request.auth. Um token roubado só permite reagendar o próprio lembrete
    // dele — nenhum dado sensível aqui.
    //
    // Contrato do documento lembretes/{token}:
    //   token         string — igual ao id do documento
    //   minutosManha  int — minutos desde meia-noite, 0 a 1439
    //   minutosNoite  int — minutos desde meia-noite, 0 a 1439
    //   fuso          string — nome IANA (ex. "America/Sao_Paulo")
    match /lembretes/{token} {
      function valido() {
        let dados = request.resource.data;
        return dados.keys().hasOnly(['token', 'minutosManha', 'minutosNoite', 'fuso']) &&
            dados.token == token &&
            dados.minutosManha is int &&
            dados.minutosManha >= 0 && dados.minutosManha < 1440 &&
            dados.minutosNoite is int &&
            dados.minutosNoite >= 0 && dados.minutosNoite < 1440 &&
            dados.fuso is string && dados.fuso.size() < 100;
      }

      allow create, update: if request.app != null && valido();
      allow read, delete: if request.app != null;
    }
  }
}
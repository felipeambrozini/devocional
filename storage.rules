rules_version = '2';

// Regras do Storage para os áudios pré-gerados da voz. Ver
// lib/dados/voz.dart (Voz._urlParaChave) para o código que lê daqui.
//
// Publicadas junto com firestore.rules a cada push na main
// (.github/workflows/deploy-web.yml, `--only ...,storage,...` — "storage",
// não "storage:rules"; o workflow explica por quê). Este arquivo é a fonte
// da verdade; não editar o console em separado.
service firebase.storage {
  match /b/{bucket}/o {
    // Áudios pré-gerados da voz (Bíblia, devocional, introduções) — ver
    // lib/dados/voz.dart (Voz._urlParaChave). Leitura pública, escrita só
    // via deploy / Admin SDK; nunca pelo app.
    match /audio/{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }
  }
}

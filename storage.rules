rules_version = '2';

// Regras do Storage para a foto de perfil da conta na nuvem. Ver
// Nuvem.atualizarFoto em lib/data/nuvem.dart para o código que grava aqui.
//
// Publicadas à mão no console do Firebase (Storage > Regras), ou com
// `firebase deploy --only storage`. Este arquivo é a fonte da verdade; não
// editar o console e este arquivo em separado.
service firebase.storage {
  match /b/{bucket}/o {
    // Um arquivo por conta, nomeado pelo próprio uid — só o dono grava.
    // Leitura pública porque o link de `getDownloadURL()` vai direto num
    // `NetworkImage` no app (`_Cabecalho` em hoje.dart), sem token de auth
    // por trás; a foto em si não é dado sensível.
    match /fotos_de_perfil/{uid}.jpg {
      allow read: if true;
      allow write: if request.auth != null &&
          request.auth.uid == uid &&
          request.auth.token.firebase.sign_in_provider == 'google.com' &&
          request.resource.size < 5 * 1024 * 1024 &&
          request.resource.contentType == 'image/jpeg';
    }
    // Áudios pré-gerados da voz (Bíblia, devocional, introduções) — ver
    // lib/data/voz.dart (Voz._urlParaChave). Leitura pública, escrita só
    // via deploy / Admin SDK; nunca pelo app.
    match /audio/{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }
  }
}

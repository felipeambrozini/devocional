<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application
        android:label="Devocional"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />

        <!-- Lembrete diário local (flutter_local_notifications, ver
             lib/data/lembretes.dart): alarmes sobrevivem ao reinício do
             celular porque este receiver os rearma no boot — sem ele, o
             lembrete sumia até o app ser aberto de novo. -->
        <receiver
            android:exported="false"
            android:name="com.dexterous.flutterlocalnotifications.RebootBroadcastReceiver">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED"/>
                <action android:name="android.intent.action.QUICKBOOT_POWERON"/>
            </intent-filter>
        </receiver>
    </application>
    <!-- O chat com as personas fala com a Gemini API pela rede (lib/data/ia.dart).
         O debug e o perfil já trazem isto embutido; sem esta linha o release
         não consegue chamar a API. -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- Tirar a foto de perfil pela câmera (lib/telas/hoje.dart); a galeria não
         precisa de permissão declarada aqui, o image_picker usa o seletor de
         fotos do sistema. -->
    <uses-permission android:name="android.permission.CAMERA"/>
    <!-- Lembrete diário no Android 13+: permissão de notificação pedida em
         runtime por lib/data/lembretes.dart; sem esta declaração nem o
         diálogo aparece. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <!-- Sem isto o RebootBroadcastReceiver acima nunca é chamado: o Android
         não entrega BOOT_COMPLETED/QUICKBOOT_POWERON a quem não declara esta
         permissão, mesmo com o <receiver> registrado. O lembrete local de
         reserva sobrevivia à reabertura do app, mas sumia num reboot até
         alguém abrir o app de novo — a declaração sozinha do receiver nunca
         foi suficiente. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>

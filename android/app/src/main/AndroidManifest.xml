<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application
        android:label="Tabernáculo"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- App Links: um link do site (devocional com ?data=, versículo
                 ?ler=, convite ?plano=) abre o app instalado em vez do
                 navegador. O Android só confia no autoVerify se o
                 /.well-known/assetlinks.json do domínio listar este pacote
                 com o SHA-256 da chave que assinou o APK (ver
                 hospedagem/.well-known/assetlinks.json e o README). Quem não
                 tem o app continua indo para o site. O caminho chega inteiro
                 ao go_router, e lib/funcoes/link_do_site.dart o traduz.
                 Um prefixo por rota de topo, e não /tabernaculo inteiro,
                 para o painel /tabernaculo/admin (só web) seguir no
                 navegador; test/app_links_test.dart confere que nenhuma
                 rota nova fique de fora. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="https"/>
                <data android:host="www.felipeambrozini.com.br"/>
                <data android:path="/tabernaculo"/>
                <data android:path="/tabernaculo/"/>
                <data android:pathPrefix="/tabernaculo/hoje"/>
                <data android:pathPrefix="/tabernaculo/biblia"/>
                <data android:pathPrefix="/tabernaculo/devocional"/>
                <data android:pathPrefix="/tabernaculo/biblioteca"/>
                <data android:pathPrefix="/tabernaculo/plano"/>
                <data android:pathPrefix="/tabernaculo/conversas"/>
                <data android:pathPrefix="/tabernaculo/ler"/>
                <data android:pathPrefix="/tabernaculo/manha"/>
                <data android:pathPrefix="/tabernaculo/promessas"/>
                <data android:pathPrefix="/tabernaculo/noite"/>
                <data android:pathPrefix="/tabernaculo/notas"/>
                <data android:pathPrefix="/tabernaculo/perfil"/>
                <data android:pathPrefix="/tabernaculo/sobre"/>
                <data android:pathPrefix="/tabernaculo/faq"/>
                <data android:pathPrefix="/tabernaculo/privacidade"/>
                <data android:pathPrefix="/tabernaculo/termos"/>
                <data android:pathPrefix="/tabernaculo/licencas"/>
                <data android:pathPrefix="/tabernaculo/charles-spurgeon"/>
                <data android:pathPrefix="/tabernaculo/felipe-ambrozini"/>
            </intent-filter>
        </activity>
        <!-- Explícito, embora seja o padrão do Flutter: é o que entrega o
             link do intent ao go_router, na abertura e com o app aberto. -->
        <meta-data
            android:name="flutter_deeplinking_enabled"
            android:value="true" />
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />

        <!-- Push dos lembretes endereçado por FID (lib/dados/lembretes.dart):
             o firebase_messaging 17 só libera `register()` com esta opção —
             sem ela lança "API disabled" e o aparelho nunca entra na coleção
             `lembretes`, então a Function não tem para quem enviar. -->
        <meta-data
            android:name="firebase_messaging_installation_id_enabled"
            android:value="true" />

        <!-- Lembrete diário local (flutter_local_notifications, ver
             lib/dados/lembretes.dart): alarmes sobrevivem ao reinício do
             celular porque este receiver os rearma no boot — sem ele, o
             lembrete sumia até o app ser aberto de novo. -->
        <receiver
            android:exported="false"
            android:name="com.dexterous.flutterlocalnotifications.RebootBroadcastReceiver">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED"/>
                <action android:name="android.intent.action.QUICKBOOT_POWERON"/>
            </intent-filter>
        </receiver>
    </application>
    <!-- O chat com as personas fala com a Gemini API pela rede (lib/dados/ia.dart).
         O debug e o perfil já trazem isto embutido; sem esta linha o release
         não consegue chamar a API. -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- Lembrete diário no Android 13+: permissão de notificação pedida em
         runtime por lib/dados/lembretes.dart; sem esta declaração nem o
         diálogo aparece. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <!-- Sem isto o RebootBroadcastReceiver acima nunca é chamado: o Android
         não entrega BOOT_COMPLETED/QUICKBOOT_POWERON a quem não declara esta
         permissão, mesmo com o <receiver> registrado. O lembrete local de
         reserva sobrevivia à reabertura do app, mas sumia num reboot até
         alguém abrir o app de novo — a declaração sozinha do receiver nunca
         foi suficiente. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
